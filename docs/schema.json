{
  "$defs": {
    "DFVInputs": {
      "properties": {
        "desirability_context": {
          "title": "Desirability Context",
          "type": "string"
        },
        "feasibility_context": {
          "title": "Feasibility Context",
          "type": "string"
        },
        "viability_context": {
          "title": "Viability Context",
          "type": "string"
        }
      },
      "required": [
        "desirability_context",
        "feasibility_context",
        "viability_context"
      ],
      "title": "DFVInputs",
      "type": "object"
    },
    "DFVOutput": {
      "description": "DFV worker output.\n\nKept flexible because the combined agent worker stores its raw\nstructured output inside `output`.",
      "properties": {
        "completed_at": {
          "anyOf": [
            {
              "format": "date-time",
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Completed At"
        },
        "correlation_id": {
          "default": "",
          "title": "Correlation Id",
          "type": "string"
        },
        "error": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Error"
        },
        "idea_name": {
          "default": "",
          "title": "Idea Name",
          "type": "string"
        },
        "output": {
          "anyOf": [
            {
              "additionalProperties": true,
              "type": "object"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Output"
        },
        "retry_count": {
          "default": 0,
          "title": "Retry Count",
          "type": "integer"
        },
        "started_at": {
          "anyOf": [
            {
              "format": "date-time",
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Started At"
        },
        "status": {
          "default": "",
          "title": "Status",
          "type": "string"
        }
      },
      "title": "DFVOutput",
      "type": "object"
    },
    "DiscoveryJobPayload": {
      "properties": {
        "biggest_uncertainty": {
          "items": {
            "type": "string"
          },
          "title": "Biggest Uncertainty",
          "type": "array"
        },
        "current_alternatives": {
          "items": {
            "type": "string"
          },
          "title": "Current Alternatives",
          "type": "array"
        },
        "customer_type": {
          "items": {
            "type": "string"
          },
          "title": "Customer Type",
          "type": "array"
        },
        "key_assumptions": {
          "items": {
            "type": "string"
          },
          "title": "Key Assumptions",
          "type": "array"
        },
        "problem_consequence": {
          "items": {
            "type": "string"
          },
          "title": "Problem Consequence",
          "type": "array"
        },
        "problem_statement": {
          "title": "Problem Statement",
          "type": "string"
        },
        "proposed_solution_context": {
          "$ref": "#/$defs/DiscoveryProposedSolutionContext"
        },
        "target_customer_segment": {
          "items": {
            "$ref": "#/$defs/DiscoverySegment"
          },
          "title": "Target Customer Segment",
          "type": "array"
        },
        "what_we_already_know": {
          "items": {
            "type": "string"
          },
          "title": "What We Already Know",
          "type": "array"
        }
      },
      "required": [
        "target_customer_segment",
        "problem_statement",
        "problem_consequence",
        "current_alternatives",
        "key_assumptions",
        "what_we_already_know",
        "biggest_uncertainty",
        "customer_type",
        "proposed_solution_context"
      ],
      "title": "DiscoveryJobPayload",
      "type": "object"
    },
    "DiscoveryOutput": {
      "properties": {
        "completed_at": {
          "anyOf": [
            {
              "format": "date-time",
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Completed At"
        },
        "correlation_id": {
          "default": "",
          "title": "Correlation Id",
          "type": "string"
        },
        "error": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Error"
        },
        "output": {
          "anyOf": [
            {
              "additionalProperties": true,
              "type": "object"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Output"
        },
        "retry_count": {
          "default": 0,
          "title": "Retry Count",
          "type": "integer"
        },
        "started_at": {
          "anyOf": [
            {
              "format": "date-time",
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Started At"
        },
        "status": {
          "default": "",
          "title": "Status",
          "type": "string"
        }
      },
      "title": "DiscoveryOutput",
      "type": "object"
    },
    "DiscoveryProposedSolutionContext": {
      "properties": {
        "purpose": {
          "title": "Purpose",
          "type": "string"
        },
        "summary": {
          "title": "Summary",
          "type": "string"
        }
      },
      "required": [
        "purpose",
        "summary"
      ],
      "title": "DiscoveryProposedSolutionContext",
      "type": "object"
    },
    "DiscoverySegment": {
      "properties": {
        "customer_type": {
          "title": "Customer Type",
          "type": "string"
        },
        "role": {
          "title": "Role",
          "type": "string"
        },
        "segment": {
          "title": "Segment",
          "type": "string"
        }
      },
      "required": [
        "segment",
        "role",
        "customer_type"
      ],
      "title": "DiscoverySegment",
      "type": "object"
    },
    "FollowupExchange": {
      "description": "One completed founder follow-up exchange.\n\npending_question is stored separately until answered.\nOnly answered questions appear in followup_history.",
      "properties": {
        "answer": {
          "title": "Answer",
          "type": "string"
        },
        "answered_at": {
          "format": "date-time",
          "title": "Answered At",
          "type": "string"
        },
        "question": {
          "title": "Question",
          "type": "string"
        },
        "turn": {
          "title": "Turn",
          "type": "integer"
        }
      },
      "required": [
        "question",
        "answer",
        "turn"
      ],
      "title": "FollowupExchange",
      "type": "object"
    },
    "PydanticObjectId": {
      "example": "5eb7cf5a86d9755df3a6c593",
      "maxLength": 24,
      "minLength": 24,
      "pattern": "^[0-9a-f]{24}$",
      "type": "string"
    },
    "SessionStatus": {
      "enum": [
        "created",
        "queued",
        "pre_eval",
        "validation_running",
        "ethics_running",
        "tipsc_running",
        "waiting_for_founder",
        "tipsc_reevaluation",
        "tipsc_completed",
        "tipsc_failed",
        "dfv_waiting",
        "dfv_running",
        "dfv_completed",
        "dfv_failed",
        "discovery_waiting",
        "discovery_running",
        "discovery_failed",
        "completed",
        "failed",
        "archived"
      ],
      "title": "SessionStatus",
      "type": "string"
    },
    "StateTransition": {
      "properties": {
        "actor": {
          "default": "system",
          "title": "Actor",
          "type": "string"
        },
        "from_status": {
          "default": "",
          "title": "From Status",
          "type": "string"
        },
        "timestamp": {
          "format": "date-time",
          "title": "Timestamp",
          "type": "string"
        },
        "to_status": {
          "title": "To Status",
          "type": "string"
        },
        "trigger": {
          "default": "unknown",
          "title": "Trigger",
          "type": "string"
        }
      },
      "required": [
        "to_status"
      ],
      "title": "StateTransition",
      "type": "object"
    },
    "TIPSCOutput": {
      "description": "Persisted TIPSC result.\n\nMust remain compatible with:\n    TIPSC-Agent/src/models.py:TIPSCOutput\n\nBackend-only metadata fields are also included.",
      "properties": {
        "completed_at": {
          "anyOf": [
            {
              "format": "date-time",
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Completed At"
        },
        "compliance_flag": {
          "default": false,
          "title": "Compliance Flag",
          "type": "boolean"
        },
        "criteria_state": {
          "additionalProperties": true,
          "title": "Criteria State",
          "type": "object"
        },
        "followups_asked": {
          "default": 0,
          "title": "Followups Asked",
          "type": "integer"
        },
        "missing_criteria": {
          "items": {
            "type": "string"
          },
          "title": "Missing Criteria",
          "type": "array"
        },
        "needs_followup": {
          "default": false,
          "title": "Needs Followup",
          "type": "boolean"
        },
        "overall_readiness": {
          "default": "",
          "title": "Overall Readiness",
          "type": "string"
        },
        "ready_for_dfv": {
          "default": false,
          "title": "Ready For Dfv",
          "type": "boolean"
        },
        "reasoning": {
          "default": "",
          "title": "Reasoning",
          "type": "string"
        },
        "refined_idea": {
          "$ref": "#/$defs/TIPSCRefinedIdea"
        },
        "solution_alignment": {
          "default": "",
          "title": "Solution Alignment",
          "type": "string"
        },
        "tips_rag_scores": {
          "$ref": "#/$defs/TIPSCRAGScores"
        },
        "tips_validated_metrics": {
          "$ref": "#/$defs/TIPSValidatedMetrics"
        }
      },
      "title": "TIPSCOutput",
      "type": "object"
    },
    "TIPSCRAGScores": {
      "properties": {
        "IMPORTANT": {
          "default": "",
          "title": "Important",
          "type": "string"
        },
        "IMPORTANT_reason": {
          "default": "",
          "title": "Important Reason",
          "type": "string"
        },
        "P": {
          "default": "",
          "title": "P",
          "type": "string"
        },
        "P_reason": {
          "default": "",
          "title": "P Reason",
          "type": "string"
        },
        "S": {
          "default": "",
          "title": "S",
          "type": "string"
        },
        "S_reason": {
          "default": "",
          "title": "S Reason",
          "type": "string"
        },
        "T": {
          "default": "",
          "title": "T",
          "type": "string"
        },
        "T_reason": {
          "default": "",
          "title": "T Reason",
          "type": "string"
        }
      },
      "title": "TIPSCRAGScores",
      "type": "object"
    },
    "TIPSCRefinedIdea": {
      "properties": {
        "consequence": {
          "default": "",
          "title": "Consequence",
          "type": "string"
        },
        "customer_segment": {
          "default": "",
          "title": "Customer Segment",
          "type": "string"
        },
        "proposed_solution": {
          "default": "",
          "title": "Proposed Solution",
          "type": "string"
        },
        "qualified_problem": {
          "default": "",
          "title": "Qualified Problem",
          "type": "string"
        }
      },
      "title": "TIPSCRefinedIdea",
      "type": "object"
    },
    "TIPSValidatedMetrics": {
      "properties": {
        "importance_metric": {
          "default": "",
          "title": "Importance Metric",
          "type": "string"
        },
        "profitability_pivot": {
          "default": "",
          "title": "Profitability Pivot",
          "type": "string"
        },
        "solvability_constraint": {
          "default": "",
          "title": "Solvability Constraint",
          "type": "string"
        },
        "timely_factor": {
          "default": "",
          "title": "Timely Factor",
          "type": "string"
        }
      },
      "title": "TIPSValidatedMetrics",
      "type": "object"
    },
    "WorkerFailureMetadata": {
      "properties": {
        "error_code": {
          "title": "Error Code",
          "type": "string"
        },
        "error_message": {
          "title": "Error Message",
          "type": "string"
        },
        "failed_at": {
          "format": "date-time",
          "title": "Failed At",
          "type": "string"
        },
        "flow": {
          "title": "Flow",
          "type": "string"
        },
        "retry_count": {
          "default": 0,
          "title": "Retry Count",
          "type": "integer"
        }
      },
      "required": [
        "flow",
        "error_code",
        "error_message"
      ],
      "title": "WorkerFailureMetadata",
      "type": "object"
    }
  },
  "properties": {
    "_id": {
      "anyOf": [
        {
          "$ref": "#/$defs/PydanticObjectId"
        },
        {
          "type": "null"
        }
      ],
      "default": null,
      "description": "MongoDB document ObjectID"
    },
    "archived_at": {
      "anyOf": [
        {
          "format": "date-time",
          "type": "string"
        },
        {
          "type": "null"
        }
      ],
      "default": null,
      "title": "Archived At"
    },
    "compliance_context": {
      "anyOf": [
        {
          "type": "string"
        },
        {
          "type": "null"
        }
      ],
      "default": null,
      "title": "Compliance Context"
    },
    "correlation_id": {
      "anyOf": [
        {
          "type": "string"
        },
        {
          "type": "null"
        }
      ],
      "default": null,
      "title": "Correlation Id"
    },
    "created_at": {
      "format": "date-time",
      "title": "Created At",
      "type": "string"
    },
    "dfv": {
      "anyOf": [
        {
          "$ref": "#/$defs/DFVOutput"
        },
        {
          "type": "null"
        }
      ],
      "default": null
    },
    "dfv_inputs": {
      "anyOf": [
        {
          "$ref": "#/$defs/DFVInputs"
        },
        {
          "type": "null"
        }
      ],
      "default": null
    },
    "discovery": {
      "anyOf": [
        {
          "$ref": "#/$defs/DiscoveryOutput"
        },
        {
          "type": "null"
        }
      ],
      "default": null
    },
    "discovery_inputs": {
      "anyOf": [
        {
          "$ref": "#/$defs/DiscoveryJobPayload"
        },
        {
          "type": "null"
        }
      ],
      "default": null
    },
    "error": {
      "anyOf": [
        {
          "type": "string"
        },
        {
          "type": "null"
        }
      ],
      "default": null,
      "title": "Error"
    },
    "ethics": {
      "anyOf": [
        {
          "additionalProperties": true,
          "type": "object"
        },
        {
          "type": "null"
        }
      ],
      "default": null,
      "title": "Ethics"
    },
    "failure_metadata": {
      "anyOf": [
        {
          "$ref": "#/$defs/WorkerFailureMetadata"
        },
        {
          "type": "null"
        }
      ],
      "default": null
    },
    "flow_requests": {
      "additionalProperties": {
        "additionalProperties": true,
        "type": "object"
      },
      "title": "Flow Requests",
      "type": "object"
    },
    "flow_started_at": {
      "anyOf": [
        {
          "format": "date-time",
          "type": "string"
        },
        {
          "type": "null"
        }
      ],
      "default": null,
      "title": "Flow Started At"
    },
    "followup_history": {
      "items": {
        "$ref": "#/$defs/FollowupExchange"
      },
      "title": "Followup History",
      "type": "array"
    },
    "followup_turn": {
      "anyOf": [
        {
          "type": "integer"
        },
        {
          "type": "null"
        }
      ],
      "default": 0,
      "title": "Followup Turn"
    },
    "idea": {
      "title": "Idea",
      "type": "string"
    },
    "idempotency_key": {
      "anyOf": [
        {
          "type": "string"
        },
        {
          "type": "null"
        }
      ],
      "default": null,
      "title": "Idempotency Key"
    },
    "pending_answer": {
      "anyOf": [
        {
          "type": "string"
        },
        {
          "type": "null"
        }
      ],
      "default": null,
      "title": "Pending Answer"
    },
    "pending_question": {
      "anyOf": [
        {
          "type": "string"
        },
        {
          "type": "null"
        }
      ],
      "default": null,
      "title": "Pending Question"
    },
    "preeval": {
      "anyOf": [
        {
          "additionalProperties": true,
          "type": "object"
        },
        {
          "type": "null"
        }
      ],
      "default": null,
      "title": "Preeval"
    },
    "preeval_input": {
      "anyOf": [
        {
          "additionalProperties": true,
          "type": "object"
        },
        {
          "type": "null"
        }
      ],
      "default": null,
      "title": "Preeval Input"
    },
    "problem_statement": {
      "title": "Problem Statement",
      "type": "string"
    },
    "regulatory": {
      "anyOf": [
        {
          "additionalProperties": true,
          "type": "object"
        },
        {
          "type": "null"
        }
      ],
      "default": null,
      "title": "Regulatory"
    },
    "rejection_reason": {
      "anyOf": [
        {
          "type": "string"
        },
        {
          "type": "null"
        }
      ],
      "default": null,
      "title": "Rejection Reason"
    },
    "state_history": {
      "items": {
        "$ref": "#/$defs/StateTransition"
      },
      "title": "State History",
      "type": "array"
    },
    "status": {
      "$ref": "#/$defs/SessionStatus",
      "default": "created"
    },
    "student_id": {
      "anyOf": [
        {
          "type": "string"
        },
        {
          "type": "null"
        }
      ],
      "default": null,
      "title": "Student Id"
    },
    "team_id": {
      "anyOf": [
        {
          "type": "string"
        },
        {
          "type": "null"
        }
      ],
      "default": null,
      "title": "Team Id"
    },
    "tipsc": {
      "anyOf": [
        {
          "$ref": "#/$defs/TIPSCOutput"
        },
        {
          "type": "null"
        }
      ],
      "default": null
    },
    "updated_at": {
      "format": "date-time",
      "title": "Updated At",
      "type": "string"
    },
    "validation": {
      "anyOf": [
        {
          "additionalProperties": true,
          "type": "object"
        },
        {
          "type": "null"
        }
      ],
      "default": null,
      "title": "Validation"
    },
    "version": {
      "default": 0,
      "title": "Version",
      "type": "integer"
    },
    "workspace_id": {
      "anyOf": [
        {
          "type": "string"
        },
        {
          "type": "null"
        }
      ],
      "default": null,
      "title": "Workspace Id"
    }
  },
  "required": [
    "problem_statement",
    "idea"
  ],
  "title": "Session",
  "type": "object"
}
