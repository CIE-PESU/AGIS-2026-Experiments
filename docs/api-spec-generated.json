                }
              }
            }
          }
        }
      },
      "delete": {
        "tags": [
          "Sessions"
        ],
        "summary": "Archive (soft-delete) a session",
        "description": "Soft-archives a session. The session is not deleted from the database \u2014 it is marked as ARCHIVED and excluded from default listing queries. Cannot archive a session while a flow is actively running. Fires a SESSION_ARCHIVED audit log entry.",
        "operationId": "archive_session_api_v1_sessions__session_id__delete",
