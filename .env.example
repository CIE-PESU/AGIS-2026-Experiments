# =============================================================================
# AGIS Platform - Global Environment Configuration
#
# Copy this file to .env and replace all placeholder values.
#
# Shared by:
#   - Backend
#   - Combined Agent Worker
#   - TIPSC Agent
#   - DFV Agent
#   - Discovery Agent
#
# Never commit your .env file.
# Commit ONLY this .env.example.
# =============================================================================


# =============================================================================
# Application
# =============================================================================

APP_NAME="AGIS Entrepreneurship Coach Platform"
APP_VERSION="1.0.0"
ENVIRONMENT=development
DEBUG=true


# =============================================================================
# MongoDB
# =============================================================================

MONGODB_URI=mongodb://localhost:27017
MONGODB_DB_NAME=agis
MONGODB_MAX_POOL_SIZE=10
MONGODB_MIN_POOL_SIZE=2


# Only needed to migrate existing encrypted-password accounts at successful login.
# Leave empty for new installations. Keep an existing key private during migration.
FERNET_KEY=


# =============================================================================
# JWT
# =============================================================================

JWT_SECRET=CHANGE_ME_TO_A_LONG_RANDOM_SECRET_AT_LEAST_32_CHARACTERS
JWT_ALGORITHM=HS256
JWT_EXPIRY_MINUTES=15
REFRESH_TOKEN_EXPIRY_DAYS=7


# =============================================================================
# PES Authentication
# =============================================================================

PES_AUTH_URL=https://pesu-auth.onrender.com/authenticate
PES_AUTH_TIMEOUT_SECONDS=5.0


# =============================================================================
# Kafka
# =============================================================================

KAFKA_BOOTSTRAP_SERVERS=localhost:9092
KAFKA_SECURITY_PROTOCOL=PLAINTEXT


# =============================================================================
# Worker Configuration
# =============================================================================

WORKER_BACKEND_URL=http://127.0.0.1:8008
WORKER_ID=combined-agent-worker-1
WORKER_INTERNAL_SECRET=CHANGE_ME_TO_A_LONG_RANDOM_WORKER_SECRET

AGENT_TIMEOUT_SECONDS=1800
CREWAI_TIMEOUT_SECONDS=600


# =============================================================================
# Rate Limiting
# =============================================================================

RATE_LIMIT_LOGIN_PER_MINUTE=5
RATE_LIMIT_API_PER_MINUTE=60


# =============================================================================
# Payload Limits
# =============================================================================

MAX_REQUEST_BODY_BYTES=1048576


# =============================================================================
# CORS
# =============================================================================

CORS_ALLOWED_ORIGINS=http://localhost:3000,http://localhost:5167


# =============================================================================
# LLM Configuration
# =============================================================================

# NVIDIA NIM (Default)
OPENAI_API_KEY=YOUR_NVIDIA_NIM_API_KEY
OPENAI_MODEL_NAME=openai/nvidia/nemotron-3.5-lightning-30b-a3b
LM_STUDIO_URL=https://integrate.api.nvidia.com/v1

# Local LM Studio Examples (Uncomment ONE if using LM Studio)
# OPENAI_API_KEY=lm-studio
# OPENAI_MODEL_NAME=openai/qwen2.5-7b-instruct
# LM_STUDIO_URL=http://localhost:1234/v1


# =============================================================================
# Search APIs
# =============================================================================

SERPER_API_KEY=YOUR_SERPER_API_KEY
TAVILY_API_KEY=YOUR_TAVILY_API_KEY


# =============================================================================
# CrewAI
# =============================================================================

CREWAI_DISABLE_TELEMETRY=true
CREWAI_TRACING_ENABLED=false


# =============================================================================
# OpenTelemetry
# =============================================================================

OTEL_SDK_DISABLED=true


# =============================================================================
# Logging
# =============================================================================

LOG_LEVEL=INFO
DISABLE_LITELLM_LOGS=true


# =============================================================================
# Agent Timeouts
# =============================================================================

VALIDATION_TIMEOUT_SECS=600
REGULATORY_TIMEOUT_SECS=300
# Persist this file/directory on a worker host; result callbacks survive restarts.
# WORKER_DELIVERY_DB=/absolute/private/path/worker-deliveries.sqlite3
# Optional sanitized export. Default is disabled; never point into the repository.
# AGIS_EXPORT_PATH=/absolute/private/path/accounts-export.json
