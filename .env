# ---------------------------------------------------------------------------

OPENAI_API_KEY=lm-studio
# OPENAI_MODEL_NAME=openai/qwen/qwen3.5-9b
OPENAI_MODEL_NAME=openai/liquid/lfm2.5-1.2b
LM_STUDIO_URL=http://localhost:1234/v1

